<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>EricksonLopez.Printing.Zpl</AssemblyName>
    <RootNamespace>EricksonLopez.Printing.Zpl</RootNamespace>
    <PackageId>EricksonLopez.Printing.Zpl</PackageId>
    <Description>Zebra Programming Language (ZPL II) industrial barcode and label generator for .NET. Supports high-resolution text, boxes, Code128 barcodes, and QR codes with 100% Native AOT compatibility.</Description>
    <PackageTags>$(CommonPackageTags);zebra;zpl;zpl2;zpl-ii;label-printer;barcode-printer;shipping-label;barcode;qr-code;native-aot</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Printing\EricksonLopez.Printing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EricksonLopez.Printing.Zpl.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
