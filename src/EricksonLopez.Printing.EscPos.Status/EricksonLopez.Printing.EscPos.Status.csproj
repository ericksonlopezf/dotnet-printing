<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>EricksonLopez.Printing.EscPos.Status</AssemblyName>
    <RootNamespace>EricksonLopez.Printing.EscPos.Status</RootNamespace>
    <PackageId>EricksonLopez.Printing.EscPos.Status</PackageId>
    <Description>Real-time hardware status monitoring, sensor telemetry, and parsing for ESC/POS thermal receipt printers. 100% Native AOT compatible.</Description>
    <PackageTags>$(CommonPackageTags);thermal-printer;receipt-printer;escpos;esc-pos;printer-status;sensors;telemetry;paper-out;native-aot</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Printing\EricksonLopez.Printing.csproj" />
    <ProjectReference Include="..\EricksonLopez.Printing.EscPos\EricksonLopez.Printing.EscPos.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EricksonLopez.Printing.EscPos.Status.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
